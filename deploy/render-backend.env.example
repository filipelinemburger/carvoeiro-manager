# Backend environment variables for the Render Web Service.
# In Render: backend service -> Environment -> Add from .env.
# Replace every placeholder before saving.

PORT=8088

# Neon direct connection strings look like:
# postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require
#
# Convert it into these three Spring datasource values:
# DB_URL=jdbc:postgresql://HOST/DATABASE?sslmode=require
# DB_USER=USER
# DB_PASSWORD=PASSWORD
DB_URL=jdbc:postgresql://replace-with-neon-host/carvoeiro-manager?sslmode=require
DB_USER=carvoeiro-manager
DB_PASSWORD=replace-with-neon-password

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXP_MIN=720
CORS_ALLOWED_ORIGINS=https://replace-with-your-render-static-site.onrender.com
