# Copy to deploy/.env on the VM and fill in real values. Never commit .env.

# The DuckDNS hostname pointing at this VM's public IP. Must match the /api/* destination
# host in frontend/vercel.json, or the frontend proxies to a host Caddy does not serve.
DOMAIN=carvoeiromanager.duckdns.org

# Postgres password (app and db share it). Generate: openssl rand -hex 24
DB_PASSWORD=

# JWT signing secret (min ~48 chars). Generate: openssl rand -hex 48
JWT_SECRET=

# Frontend origin(s) allowed by CORS, comma-separated.
CORS_ALLOWED_ORIGINS=https://carvoeiromanager.vercel.app
